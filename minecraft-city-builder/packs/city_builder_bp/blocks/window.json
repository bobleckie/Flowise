{
    "format_version": "1.21.10",
    "minecraft:block": {
        "description": {
            "identifier": "cb:window",
            "menu_category": {
                "category": "construction"
            },
            "states": {
                "cb:style": [
                    "dark",
                    "light",
                    "bronze",
                    "black"
                ]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180
                }
            }
        },
        "components": {
            "minecraft:geometry": "geometry.cb_window",
            "minecraft:material_instances": {
                "*": {
                    "texture": "cb_window_dark",
                    "render_method": "blend"
                }
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1.5
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 3
            },
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    16,
                    16
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    16,
                    16
                ]
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('cb:style') == 'dark'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "cb_window_dark",
                            "render_method": "blend"
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('cb:style') == 'light'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "cb_window_light",
                            "render_method": "blend"
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('cb:style') == 'bronze'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "cb_window_bronze",
                            "render_method": "blend"
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('cb:style') == 'black'",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "cb_window_black",
                            "render_method": "blend"
                        }
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            270,
                            0
                        ]
                    }
                }
            }
        ]
    }
}
